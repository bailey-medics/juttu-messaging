{
  "name": "juttu-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \".storybook/**/*.{ts,tsx}\" \"*.{ts,js,cjs}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,css}\" \".storybook/**/*.{ts,tsx}\" \"*.{ts,js,cjs}\"",
    "test": "vitest",
    "test:ci": "vitest run",
    "storybook": "storybook dev -p ${JUTTU_STORYBOOK_PORT:-6106} --no-open",
    "build-storybook": "storybook build --quiet"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "storybook": "10.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild": false
  }
}
