{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict, and strict about the things that bite: an unchecked index
       access is how a list renders `undefined`. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,

    /* One alias, for one way to name a file: `@/pages/HomePage` rather than
       a chain of `../../`. Vite, Vitest and Storybook read it from here. */
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", ".storybook/*.ts", ".storybook/*.tsx"],
  /* The service worker has a config of its own, tsconfig.sw.json. */
  "exclude": ["src/sw.ts"]
}
