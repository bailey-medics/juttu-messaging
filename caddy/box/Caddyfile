# Caddy for the long-running copy on the dev box (compose.box.yml).
#
# It serves the built frontend from /srv and passes /api to the backend.
# It listens on plain HTTP inside the stack; compose.box.yml publishes it on
# this machine only, on JUTTU_BOX_PORT (8290). HTTPS comes from the private
# network's own certificate, in front of that port: see docs/dev-box.md.

{
	# The private network ends TLS before Caddy, so Caddy asks for no
	# certificate of its own.
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# A browser installs the PWA only when its manifest has this type.
		# The service worker, the manifest and the page that loads them are
		# always fetched fresh, so a deploy reaches every phone.
		@webmanifest path /*.webmanifest
		header @webmanifest Content-Type "application/manifest+json"

		@fresh path /sw.js /index.html / /*.webmanifest
		header @fresh Cache-Control "no-cache"

		# Built files carry a hash of their content in their name, so a stored
		# copy is never out of date.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Any other path is a page of the app, which its router draws.
		try_files {path} /index.html
		file_server
	}
}
