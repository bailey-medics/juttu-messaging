# Copy to .env, in the repository root, to change a setting on this
# machine. Docker Compose reads .env by itself, and git ignores it.
# Each value below is the default, used when .env does not set it.

# The address every published port listens on. 127.0.0.1 means this
# machine only.
JUTTU_BIND=127.0.0.1

# Caddy, in front of the app and the API. Open http://localhost:8180.
JUTTU_HTTP_PORT=8180
JUTTU_HTTPS_PORT=8543

# The backend, directly.
JUTTU_WEB_PORT=8100

# The Vite dev server, directly, and Storybook.
JUTTU_FRONTEND_PORT=5273
JUTTU_STORYBOOK_PORT=6106

# The development database.
JUTTU_POSTGRES_PORT=5533
