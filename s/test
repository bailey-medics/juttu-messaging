#!/usr/bin/env bash
# Run the test suites.
#
# Usage:
#   s/test                    every suite
#   s/test s/tests            the bats tests only
#   s/test backend [args]     the backend tests only, with pytest's args
#
# The suites:
#
#   s/tests/   bats tests for the scripts in s/ and the git hook. They run
#              on the host and need bats; nothing they test reaches Docker
#              or GitHub.
#   backend/   pytest, in a throwaway container built from the backend's
#              dev image with this worktree mounted, so it runs from any
#              worktree without the dev stack. See compose.unit-tests.yml.
#
# Each later phase of the skeleton plan adds its own suite here.
set -euo pipefail

cd "$(dirname "$0")/.."

run_bats() {
	if ! command -v bats >/dev/null 2>&1; then
		echo "bats not found. Install it with your package manager, such as:" >&2
		echo "  sudo apt install bats" >&2
		exit 1
	fi

	echo "==> bats s/tests"
	bats s/tests
}

# Each worktree gets its own compose project, named from its folder, so
# two worktrees testing at once never share a container.
test_project() {
	local name

	name="$(basename "$(pwd -P)" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-')"

	echo "juttu-test-${name}"
}

run_backend() {
	if ! command -v docker >/dev/null 2>&1; then
		echo "docker not found. The backend tests run in a container, so Docker is needed." >&2
		exit 1
	fi

	echo "==> pytest backend (in a throwaway container)"

	# On Linux the container runs as the host user, so what pytest writes
	# into the worktree stays the host user's.
	HOST_UID="$(id -u)" HOST_GID="$(id -g)" \
		docker compose -p "$(test_project)" -f compose.unit-tests.yml \
		run --rm --build backend pytest "$@"
}

case "${1:-}" in
	"")
		run_bats
		run_backend
		;;
	s/tests)
		run_bats
		;;
	backend)
		shift
		run_backend "$@"
		;;
	*)
		echo "Usage: s/test [s/tests | backend [pytest args]]" >&2
		exit 2
		;;
esac
