#!/usr/bin/env bash
# Make the first account on the development stack, asking for its username
# and password.
#
# Usage: s/first-account
#
# Runs once per database: the command refuses once any account exists,
# because every later account comes from an invite. The stack must be up
# (s/up). For the copy on the dev box, use s/box first-account.
set -euo pipefail

main() {
	cd "$(dirname "${BASH_SOURCE[0]}")/.."

	# shellcheck source=utils/dev-stack.sh
	source s/utils/dev-stack.sh

	dev_stack exec backend python manage.py create_first_account
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
